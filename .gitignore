# =========================
# Node / Firebase Functions
# =========================
node_modules/
**/node_modules/

# =========================
# Flutter / Dart build + tool artifacts
# =========================
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# =========================
# Flutter web build artifacts (optional)
# =========================
/build/

# =========================
# Flutter desktop ephemeral (generated)
# =========================
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
windows/flutter/ephemeral/

# =========================
# Web-only repo: do not track platform folders
# (Remove these folders from repo if already tracked)
# =========================
android/
ios/
macos/
linux/
windows/

# =========================
# Firebase local CLI/state directory
# =========================
.firebase/

# =========================
# Secrets / env files
# =========================
.env
.env.*
dotenv
migrate_working_dir/

# =========================
# Miscellaneous
# =========================
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# =========================
# IntelliJ / Android Studio
# =========================
*.iml
*.ipr
*.iws
.idea/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# =========================
# Dart doc output
# =========================
**/doc/api/
**/ios/Flutter/.last_build_id

# =========================
# Symbolication / Obfuscation
# =========================
app.*.symbols
app.*.map.json

# =========================
# VS Code
# Keep only workspace settings if you want
# =========================
.vscode/*
!.vscode/settings.json

# =========================
# (Optional) If you ever add generated JS maps, caches, etc.
# =========================
*.map
